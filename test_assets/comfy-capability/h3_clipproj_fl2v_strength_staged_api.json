{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "first-frame-fullbody.png"}
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {"image": "last-frame-wave.png"}
  },
  "3": {
    "class_type": "ClipProjLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "auto",
      "projection": "h3_qwen3vl_4b_tap24.safetensors",
      "device": "cuda:1",
      "mode": "resident"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}
  },
  "5": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "prompt": "A cinematic full-body portrait of the same person. They begin standing calmly, then naturally raise one hand into a friendly wave while maintaining identity, clothing, facial features, and the original background. Subtle breathing, realistic blinking, stable anatomy, smooth deliberate motion, no camera cut. Audio: quiet room ambience, soft clothing movement, and the person clearly says, 'Hello, it is good to see you.'",
      "width": 352,
      "height": 608,
      "length": 73,
      "first_frame": ["1", 0],
      "last_frame": ["2", 0]
    }
  },
  "6": {
    "class_type": "ClipProjFree",
    "inputs": {
      "scope": "all models",
      "after": ["5", 0]
    }
  },
  "7": {
    "class_type": "OmniH3ReferenceStrength",
    "inputs": {
      "conditioning": ["6", 0],
      "visual_reference_strength": 0.999,
      "audio_reference_strength": 1.0
    }
  },
  "8": {
    "class_type": "OmniH3StageSampler",
    "inputs": {
      "conditioning": ["7", 0],
      "latent": ["5", 1],
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default",
      "noise_seed": 424242,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "steps": 12,
      "denoise": 1.0,
      "device": "primary"
    }
  },
  "9": {
    "class_type": "OmniH3StageDecode",
    "inputs": {
      "samples": ["8", 0],
      "video_vae_name": "minimax_h3_video_vae_fp16.safetensors",
      "audio_vae_name": "minimax_h3_audio_vae_fp32.safetensors",
      "video_device": "auxiliary:1",
      "audio_device": "auxiliary:1"
    }
  },
  "10": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["9", 0],
      "audio": ["9", 1],
      "fps": 24.0,
      "bit_depth": 8
    }
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["10", 0],
      "filename_prefix": "capability_tests/H3_ClipProj_FL2V_Strength0999_Staged",
      "format": "mp4",
      "codec": "h264",
      "codec.encoding": "re-encode",
      "codec.encoding.crf": 18.0
    }
  }
}
