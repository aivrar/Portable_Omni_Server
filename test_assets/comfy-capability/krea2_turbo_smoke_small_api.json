    "class_type": "VAEDecode",
    "inputs": {"samples": ["6", 0], "vae": ["7", 0]}
  },
  "9": {
    "_meta": {"title": "Routed output"},
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "capability_tests/Krea2_Turbo_Smoke", "images": ["8", 0]}
  }
