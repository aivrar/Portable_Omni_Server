      "model": ["1", 0],
      "negative": ["4", 0],
      "positive": ["3", 0],
      "sampler_name": "euler",
      "scheduler": "simple",
      "seed": 20260811,
      "steps": 4
    }
  },
  "7": {
    "_meta": {"title": "Qwen Image VAE"},
    "class_type": "VAELoader",
